# Loaded automatically from configs/mcp_servers/*.yaml on next startup.
# Generated helper uses the host native process boundary and workspace guards.
mcp_servers:
  - name: {{.Names.Tool}}
    command: python
    args:
      - {{.Tool.Target}}
    enabled: true
    timeout: 30s
    workdir: .
    env_allowlist: [PATH, HOME, USERPROFILE, LOCALAPPDATA, TMP, TEMP]
    network_disabled: true
    isolation: auto
    restart_limit: 3
    cooldown: 10s
    max_concurrent_calls: 1
    allowed_commands:
      - python
    max_request_bytes: 65536
    max_response_bytes: 2097152
