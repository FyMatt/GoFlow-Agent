# Loaded automatically from configs/mcp_servers/*.yaml on next startup.
mcp_servers:
  - name: {{.ServerName}}
    command: python
    args:
      - ./mcp_servers/{{.Name}}.py
    enabled: true
    timeout: 30s
    workdir: .
    env_allowlist: [PATH, HOME, USERPROFILE, LOCALAPPDATA, TMP, TEMP]
    isolation: process_group
    restart_limit: 3
    cooldown: 10s
    max_concurrent_calls: 1
    allowed_commands:
      - python
    max_request_bytes: 65536
    max_response_bytes: 2097152
